{
  "name": "kubesec-diagram",
  "version": "2026.9.6",
  "private": true,
  "description": "Kubernetes security diagram definition for diagram-webkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubesec-diagram/kubesec-diagram.github.io.git"
  },
  "homepage": "https://kubesec-diagram.github.io",
  "bugs": "https://github.com/kubesec-diagram/kubesec-diagram.github.io/issues",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./definition": "./definition.js",
    "./kubesec-diagram.svg": "./kubesec-diagram.svg",
    "./kubesec-diagram.drawio.svg": "./kubesec-diagram.drawio.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "definition.js",
    "views.js",
    "config",
    "content",
    "kubesec-diagram.svg",
    "kubesec-diagram.drawio.svg",
    "METADATA.md"
  ],
  "scripts": {
    "predev": "node scripts/changelog.mjs --write",
    "dev": "vite",
    "prebuild": "node scripts/changelog.mjs --write",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "diagram-webkit validate kubesec-diagram.drawio.svg --definition definition.js",
    "render": "diagram-webkit render kubesec-diagram.drawio.svg --out kubesec-diagram.svg --definition definition.js",
    "generate": "node scripts/changelog.mjs --write && diagram-webkit tag-tree METADATA.md --out config/tag-descriptions.generated.js",
    "check": "node scripts/check-no-logic.mjs && npm run validate",
    "test:parity": "sh tests/parity/setup.sh && playwright test --config tests/parity/playwright.config.ts",
    "engine:latest": "npm install diagram-webkit@latest --no-save --prefer-online --no-audit --no-fund && npm ls diagram-webkit"
  },
  "dependencies": {
    "diagram-webkit": ">=0.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "vite": "^8.3.0"
  },
  "x-ported-from": {
    "repository": "https://github.com/kubesec-diagram/kubesec-diagram.github.io",
    "commit": "9847549b2d529942ad21339ea3a36c89f2e8f833",
    "tag": "v2026.09.4",
    "files": {
      "data.js": [
        "config/tags.js",
        "config/annotations.js",
        "config/ui.js"
      ],
      "index.html": [
        "content/page.js",
        "content/about.js",
        "content/footer.js"
      ],
      "styles.css": [
        "content/css.js"
      ],
      "METADATA.md": [
        "METADATA.md",
        "config/tag-descriptions.generated.js (generated)"
      ],
      "kubesec-diagram.svg": [
        "kubesec-diagram.svg"
      ],
      "LICENSE": [
        "LICENSE"
      ],
      "README.md": [
        "README.md"
      ],
      ".gitattributes": [
        ".gitattributes"
      ]
    }
  }
}
